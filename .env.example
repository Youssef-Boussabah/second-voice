# ── MongoDB Atlas ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=second_voice
USE_CHANGE_STREAMS=true
DEMO_USER_ID=usr_maya

# ── LLM ─────────────────────────────────────────────────────────
LLM_PROVIDER=nebius               # nebius | anthropic | openai
# Nebius Token Factory (OpenAI-compatible). Model verified via /v1/models at startup;
# falls back to the first available of NEBIUS_FALLBACK_MODELS if missing.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507   # hot path (~1 s); GLM-5.3-Flash measured 8.6 s+
NEBIUS_SUMMARY_MODEL=zai-org/GLM-5.3-Flash
SUGGEST_MODEL=claude-haiku-5-5
SUMMARY_MODEL=claude-sonnet-5-5
OPENAI_SUGGEST_MODEL=gpt-5-mini     # only if LLM_PROVIDER=openai; use a model your key has
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Embeddings (Voyage AI) ──────────────────────────────────────
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4-lite
EMBED_DIM=1024

# ── Voice (ElevenLabs) ──────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                # Maya's consented Instant Voice Clone
STT_MODEL=scribe_v2                 # scribe_v3 launched Nov 10, so try it if v2 struggles
TTS_MODEL=eleven_flash_v2_5
VOICE_EMBED_DIM=192
SPEAKER_THRESHOLD=0.80              # tune with scripts/voice_calibrate.py

# ── Observability (LangSmith is a prize partner) ────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=second-voice

# ── Mocks (true = no external call) ─────────────────────────────
MOCK_LLM=true
MOCK_EMBED=true
MOCK_STT=true
MOCK_SPEAKER=true
MOCK_TTS=true

# ── App ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# Frontend reads this from frontend/.env
VITE_API_URL=http://localhost:8000
