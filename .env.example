# Second Voice backend config. Copy to `.env` at the repo root (never commit it).
# One value per key: a duplicated key silently overrides the earlier line.

# ── MongoDB Atlas ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=second_voice
# Change streams power the learning worker and the live "Learned:" toasts (Atlas required).
USE_CHANGE_STREAMS=true
DEMO_USER_ID=usr_maya

# ── LLM (Nebius Token Factory, OpenAI-compatible) ───────────────
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Reply suggestions (hot path). Verified against /v1/models at startup.
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Episode summaries (worker; latency-tolerant reasoning model).
NEBIUS_SUMMARY_MODEL=zai-org/GLM-5.3-Flash
# Optional hedge: if NEBIUS_MODEL has not answered after LLM_HEDGE_AFTER_S seconds, the same
# prompt also goes to this model and the first valid answer wins. Leave empty to disable.
LLM_HEDGE_MODEL=MiniMaxAI/MiniMax-M3.1-Flash
LLM_HEDGE_AFTER_S=1.5
LLM_TIMEOUT_S=10
# Alternative providers (only if LLM_PROVIDER=anthropic|openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Embeddings (Voyage AI) ──────────────────────────────────────
# Without a payment method Voyage allows 3 requests/minute: retrieval then degrades to
# text search and new memories are saved without vectors (seed/backfill_embeddings.py fills them).
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4-lite
EMBED_DIM=1024

# ── Voice (ElevenLabs) ──────────────────────────────────────────
ELEVENLABS_API_KEY=
# A voice cloned ONLY with the speaker's explicit consent.
ELEVENLABS_VOICE_ID=
STT_MODEL=scribe_v2
TTS_MODEL=eleven_flash_v2_5
VOICE_EMBED_DIM=192
SPEAKER_THRESHOLD=0.80

# ── Mocks (true = no external call; the demo should run with these false) ──
MOCK_LLM=false
MOCK_EMBED=false
MOCK_STT=false
MOCK_TTS=false
# Speaker ID needs torch + speechbrain (not in requirements-core.txt) and consented enrollment.
# With true, the partner is chosen manually in the UI.
MOCK_SPEAKER=true

# ── App ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Debug only: logs the full suggestion prompt (contains private memories).
LOG_PROMPTS=false
